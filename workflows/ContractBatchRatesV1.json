{
  "id": "ContractBatchRatesV1",
  "name": "Договоры — сверить тарифы Excel",
  "active": false,
  "nodes": [
    {
      "id": "ContractBatchRatesTrigger",
      "name": "Получить тарифные приложения",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        0
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "ContractBatchRatesCheck",
      "name": "Есть тарифные приложения?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        224,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "optional-rates",
              "leftValue": "={{ !!($binary?.approved || $binary?.vendor) }}",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "ContractBatchRatesPack",
      "name": "Подготовить XLSX",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        -112
      ],
      "parameters": {
        "jsCode": "const item = $input.first();\nconst result = {batchId: item.json.batchId};\nfor (const field of ['approved', 'vendor']) {\n  const file = item.binary?.[field];\n  if (!file) continue;\n  const buffer = await this.helpers.getBinaryDataBuffer(0, field);\n  result[field] = {name: file.fileName || field + '.xlsx', content: buffer.length <= 2 * 1024 * 1024 ? buffer.toString('base64') : ''};\n}\nreturn [{json:result}];"
      }
    },
    {
      "id": "ContractBatchRatesSubmit",
      "name": "Сверить и сохранить тарифы",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        672,
        -112
      ],
      "parameters": {
        "method": "PUT",
        "url": "={{ 'http://host.docker.internal:8765/api/batches/' + $json.batchId + '/rates' }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({approved: $json.approved, vendor: $json.vendor}) }}",
        "options": {
          "timeout": 30000
        }
      }
    },
    {
      "id": "ContractBatchRatesSkip",
      "name": "Пропустить сверку тарифов",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        448,
        112
      ],
      "parameters": {}
    }
  ],
  "connections": {
    "Получить тарифные приложения": {
      "main": [
        [
          {
            "node": "Есть тарифные приложения?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Есть тарифные приложения?": {
      "main": [
        [
          {
            "node": "Подготовить XLSX",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Пропустить сверку тарифов",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Подготовить XLSX": {
      "main": [
        [
          {
            "node": "Сверить и сохранить тарифы",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "callerPolicy": "workflowsFromSameOwner"
  }
}
