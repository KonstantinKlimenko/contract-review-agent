        0,
        1024
      ],
      "webhookId": "contract-review-templates",
      "parameters": {
        "authentication": "n8nUserAuth",
        "requireExecuteAccess": true,
        "formTitle": "Загрузка шаблонов проверки",
        "formDescription": "Выберите шаблон договора DOCX или текстовый PDF, согласованные тарифы XLSX или оба файла. Сохранённые версии будут использоваться в новых проверках.",
        "formFields": {
          "values": [
            {
              "fieldLabel": "Шаблон договора DOCX или PDF",
              "fieldType": "file",
              "fieldName": "word_template",
              "multipleFiles": false,
              "requiredField": false,
              "acceptFileTypes": ".docx,.pdf"
            },
            {
              "fieldLabel": "Согласованные тарифы XLSX",
              "fieldType": "file",
              "fieldName": "rates_template",
              "multipleFiles": false,
              "requiredField": false,
              "acceptFileTypes": ".xlsx"
            }
          ]
        },
        "responseMode": "lastNode",
        "options": {
          "path": "contract-review-templates",
          "buttonLabel": "Сохранить и активировать",
          "includeUserInOutput": false
        }
      }
    },
    {
      "id": "ContractTemplatePackV1",
      "name": "Подготовить шаблоны",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        1024
      ],
      "parameters": {
        "jsCode": "const files = $input.first().binary ?? {};\nconst result = {};\nfor (const [field, key] of [['word', 'word_template'], ['rates', 'rates_template']]) {\n  if (!files[key]) continue;\n  const buffer = await this.helpers.getBinaryDataBuffer(0, key);\n  result[field] = {name: files[key].fileName, content: buffer.toString('base64')};\n}\nreturn [{ json: result }];"
      }
    },
    {
      "id": "ContractTemplateSaveV1",
      "name": "Активировать версии",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        448,
        1024
      ],
      "parameters": {
        "method": "POST",
        "url": "http://host.docker.internal:8765/api/templates",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          }
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "ContractTemplateFinishV1",
      "name": "Открыть активные шаблоны",
      "type": "n8n-nodes-base.form",
      "typeVersion": 2.5,
      "position": [
        672,
        1024
      ],
