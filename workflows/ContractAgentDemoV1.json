      }
    },
    {
      "id": "BatchWordTemplateCatalogV1",
      "name": "Получить список шаблонов",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        224,
        784
      ],
      "parameters": {
        "url": "http://host.docker.internal:8765/api/templates",
        "options": {
          "timeout": 10000
        }
      }
    },
    {
      "id": "BatchWordTemplatePickerV1",
      "name": "Выбрать шаблон и файлы",
      "type": "n8n-nodes-base.form",
      "typeVersion": 2.5,
      "position": [
        448,
        784
      ],
      "parameters": {
        "operation": "page",
        "defineForm": "json",
        "jsonOutput": "={{ (() => {\nconst templates = $json.templates ?? [];\nconst uploads = [{\"fieldLabel\":\"Договоры DOCX или PDF\",\"fieldType\":\"file\",\"fieldName\":\"docx\",\"acceptFileTypes\":\".docx,.pdf\",\"requiredField\":true,\"multipleFiles\":true},{\"fieldName\":\"approved_rates\",\"fieldLabel\":\"Согласованные тарифы XLSX для разовой сверки\",\"fieldType\":\"file\",\"multipleFiles\":false,\"acceptFileTypes\":\".xlsx\",\"requiredField\":false},{\"fieldName\":\"vendor_rates\",\"fieldLabel\":\"Тарифы перевозчика XLSX\",\"fieldType\":\"file\",\"multipleFiles\":false,\"acceptFileTypes\":\".xlsx\",\"requiredField\":false}];\nconst picker = templates.length ? [{\n  fieldLabel: 'Шаблон договора', fieldName: 'template_choice', fieldType: 'dropdown',\n  fieldOptions: {values: templates.map(t => ({option: t.label}))},\n  defaultValue: templates.find(t => t.active)?.label ?? templates[0].label,\n  requiredField: true\n}] : [{fieldType:'html', html:'<p>Сначала загрузите шаблон договора.</p><a href=\"http://localhost:5678/form/contract-review-templates\" target=\"_blank\" rel=\"noopener\">Загрузить шаблон договора или согласованные тарифы</a>'}];\nreturn JSON.stringify([...picker, ...uploads]);\n})() }}",
        "options": {
          "formTitle": "Шаблон и файлы пакета",
          "formDescription": "Один шаблон применяется ко всем DOCX и PDF в пакете. Excel нужен для сверки ставок.",
          "buttonLabel": "Проверить пакет"
        }
      },
      "webhookId": "contract-agent-batch-documents"
    },
    {
      "id": "BatchWordTemplateMappingV1",
      "name": "Зафиксировать версию шаблона",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        672,
        784
      ],
      "parameters": {
        "jsCode": "const item = $input.first();\nconst {templates} = $('Получить список шаблонов').first().json;\nconst selected = templates.find(template => template.label === item.json.template_choice);\nreturn [{json:{...item.json, template_version: selected?.version ?? 'missing'}, binary:item.binary}];"
      }
    }
